# Fixed visual settings for LENS paper-note PowerPoint output.
# Colors use six-digit RGB hex values without '#'. Measurements use inches.

[cover_kicker]
text = Journal Report
font_name = Arial
east_asia_font = SimHei
font_size_pt = 42
font_color = 000000
bold = true
italic = false
left_in = 1.0
right_in = 1.0
top_in = 2.15
height_in = 0.65
align = center

[paper_title]
font_name = Arial
east_asia_font = SimHei
font_size_pt = 42
font_color = 000000
bold = true
italic = false
left_in = 1.0
right_in = 1.0
top_in = 2.95
height_in = 1.70
align = center

[presenter]
font_name = Arial
east_asia_font = SimHei
font_size_pt = 18
font_color = 000000
bold = false
italic = false
right_in = 0.75
bottom_in = 0.70
width_in = 4.0
height_in = 0.45
align = center

[page_number]
show = true
show_on_cover = false
start_at = 1
font_name = Arial
east_asia_font = SimHei
font_size_pt = 10
font_color = A6A6A6
bold = false
italic = false
right_in = 0.18
bottom_in = 0.10
width_in = 0.36
height_in = 0.24
align = right

[citation]
font_name = Arial
east_asia_font = SimHei
font_size_pt = 14
font_color = 969696
bold = false
italic = true
left_in = 0.50
right_in = 0.50
bottom_in = 0.04
height_in = 0.58
image_height_in = 0.35
image_gap_above_in = 0.04
align = center

[section_title]
font_name = Arial
east_asia_font = SimHei
font_size_pt = 44
font_color = 000000
bold = true
italic = false
left_in = 1.0
right_in = 1.0
height_in = 0.78
align = center

[results_outline_title]
text = Overall study strategy and workflow
font_name = Arial
east_asia_font = SimHei
font_size_pt = 32
font_color = 000000
bold = true
italic = false
left_in = 0.70
right_in = 0.70
top_in = 0.22
height_in = 0.65
align = center

[results_outline_item]
font_name = Arial
east_asia_font = SimHei
font_size_pt = 22
font_color = 000000
bold = true
italic = false
left_in = 1.00
right_in = 0.50
list_top_in = 1.25
list_bottom_in = 0.60
height_in = 0.50
gap_in = 0.12
align = left

[results_outline_inactive_item]
font_name = Arial
east_asia_font = SimHei
font_size_pt = 22
font_color = B5B5B5
bold = true
italic = false
align = left

[content_title]
font_name = Arial
east_asia_font = SimHei
font_size_pt = 22
font_color = 000000
bold = true
italic = false
left_in = 0.55
right_in = 0.55
top_in = 0.08
height_in = 0.58
align = center

[content_subtitle]
font_name = Arial
east_asia_font = SimHei
font_size_pt = 18
font_color = 000000
bold = false
italic = false
left_in = 0.80
right_in = 0.80
top_in = 0.68
height_in = 0.42
align = left

[image_caption]
show_above_h3 = true
prefix = □
font_name = Arial
east_asia_font = SimHei
font_size_pt = 18
font_color = 000000
bold = true
italic = false
height_in = 0.45
gap_below_in = 0.08
align = center
